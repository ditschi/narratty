{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ditschi/narratty/main/schema/v1.json",
  "$defs": {
    "Browser": {
      "additionalProperties": false,
      "description": "A web page or local HTML file. ``browser: URL`` is short for ``browser: {url: URL}``.",
      "properties": {
        "url": {
          "description": "An http(s) URL, or an HTML file in the workspace.",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "scroll": {
          "anyOf": [
            {
              "enum": [
                "none",
                "auto"
              ],
              "type": "string"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "default": "none",
          "description": "Scroll down while shown: auto (to the end of the page, at most 4 screens) or this many pixels.",
          "title": "Scroll"
        },
        "duration_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hide after this long; by default it stays until the scene ends.",
          "title": "Duration Ms"
        },
        "load_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "default": 5000,
          "description": "How long the page may load before it is captured.",
          "title": "Load Ms"
        }
      },
      "required": [
        "url"
      ],
      "title": "Browser",
      "type": "object"
    },
    "CtrlSequence": {
      "additionalProperties": false,
      "description": "Send a control chord such as ``C-c``.",
      "properties": {
        "ctrl_sequence": {
          "pattern": "^C-[A-Za-z@\\[\\]\\\\^_]$",
          "title": "Ctrl Sequence",
          "type": "string"
        }
      },
      "required": [
        "ctrl_sequence"
      ],
      "title": "CtrlSequence",
      "type": "object"
    },
    "Diff": {
      "additionalProperties": false,
      "description": "Show what changed in the workspace since the recording started.\n\nWritten as the bare string ``diff`` in YAML, or with paths to limit it to.",
      "properties": {
        "diff": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "default": true,
          "title": "Diff"
        }
      },
      "title": "Diff",
      "type": "object"
    },
    "EndCard": {
      "additionalProperties": false,
      "description": "The closing \"Created with narratty\" card with a link and QR code to the docs.",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show the card. Unset follows ~/.config/narratty/config.toml (on by default).",
          "title": "Enabled"
        },
        "duration_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "default": 4000,
          "description": "How long the card stays on screen.",
          "title": "Duration Ms"
        },
        "qr": {
          "default": true,
          "description": "Show a QR code of the docs link when the terminal is large enough.",
          "title": "Qr",
          "type": "boolean"
        }
      },
      "title": "EndCard",
      "type": "object"
    },
    "Enter": {
      "additionalProperties": false,
      "description": "Press Enter. Legacy form of ``key: Enter``, written as the bare string ``enter``.",
      "properties": {
        "enter": {
          "const": true,
          "default": true,
          "title": "Enter",
          "type": "boolean"
        }
      },
      "title": "Enter",
      "type": "object",
      "deprecated": true,
      "deprecationMessage": "Write `key: Enter` instead."
    },
    "EnvBuild": {
      "additionalProperties": false,
      "description": "Build the environment's image from a Dockerfile (paths relative to the spec).",
      "properties": {
        "context": {
          "default": ".",
          "description": "Build context.",
          "title": "Context",
          "type": "string"
        },
        "dockerfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dockerfile; defaults to <context>/Dockerfile.",
          "title": "Dockerfile"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Build stage to stop at.",
          "title": "Target"
        },
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Build arguments.",
          "title": "Args",
          "type": "object"
        }
      },
      "title": "EnvBuild",
      "type": "object"
    },
    "EnvCompose": {
      "additionalProperties": false,
      "description": "A service of the project's Compose file (path relative to the spec).",
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "default": "compose.yaml",
          "description": "Compose file, or several merged in order.",
          "title": "File"
        },
        "service": {
          "description": "Service the demo shell runs in.",
          "minLength": 1,
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service"
      ],
      "title": "EnvCompose",
      "type": "object"
    },
    "Environment": {
      "additionalProperties": false,
      "description": "A project container the demo shell runs in; the rest of narratty stays outside it.",
      "properties": {
        "image": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Image to run the demo shell in.",
          "title": "Image"
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvBuild"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Build the image from a Dockerfile instead."
        },
        "compose": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvCompose"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run in a service of a Compose file."
        },
        "container": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run in this running container.",
          "title": "Container"
        },
        "devcontainer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run as this devcontainer.json describes (image, Dockerfile or Compose service).",
          "title": "Devcontainer"
        },
        "workdir": {
          "anyOf": [
            {
              "pattern": "^/",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the shell starts; for image and build also where the workspace is mounted (default /work). compose and container default to the container's working directory.",
          "title": "Workdir"
        },
        "user": {
          "default": "host",
          "description": "host: your user id, so files stay yours; image: the image's user; a user name; or UID[:GID].",
          "pattern": "^(host|image|[0-9]+(:[0-9]+)?|[a-z_][a-z0-9_-]*)$",
          "title": "User",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Variables set in the environment's container.",
          "title": "Env",
          "type": "object"
        },
        "read_only": {
          "default": false,
          "description": "Mount the image's root filesystem read-only.",
          "title": "Read Only",
          "type": "boolean"
        },
        "packages": {
          "default": [],
          "description": "Packages to add for the demo, with the image's package manager.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_:=~<>*-]*$",
            "type": "string"
          },
          "title": "Packages",
          "type": "array"
        },
        "package_manager": {
          "default": "auto",
          "description": "auto detects it in the image.",
          "enum": [
            "auto",
            "apt",
            "apk",
            "dnf",
            "microdnf",
            "yum",
            "zypper"
          ],
          "title": "Package Manager",
          "type": "string"
        },
        "setup": {
          "default": [],
          "description": "Shell commands run as root when the image is built (after packages).",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Setup",
          "type": "array"
        },
        "toolkit": {
          "default": "prefer",
          "description": "Mount narratty's demo toolkit: first on PATH (prefer), last (fallback) or not (off).",
          "enum": [
            "prefer",
            "fallback",
            "off"
          ],
          "title": "Toolkit",
          "type": "string"
        }
      },
      "title": "Environment",
      "type": "object"
    },
    "Focus": {
      "additionalProperties": false,
      "description": "Move the keyboard to a pane of the editor layout.",
      "properties": {
        "focus": {
          "enum": [
            "explorer",
            "terminal"
          ],
          "title": "Focus",
          "type": "string"
        }
      },
      "required": [
        "focus"
      ],
      "title": "Focus",
      "type": "object"
    },
    "Hold": {
      "additionalProperties": false,
      "description": "Pause. ``auto`` waits here until the narration has finished.\n\nOnly needed mid-scene: after the last action, a scene always waits for its narration.",
      "properties": {
        "hold": {
          "anyOf": [
            {
              "const": "auto",
              "type": "string"
            },
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "title": "Hold"
        }
      },
      "required": [
        "hold"
      ],
      "title": "Hold",
      "type": "object"
    },
    "Key": {
      "additionalProperties": false,
      "description": "Press a key, optionally repeated (``Down 3``). Names are case-insensitive.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "Key",
      "type": "object"
    },
    "KokoroOptions": {
      "additionalProperties": false,
      "properties": {
        "speed": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "number"
        },
        "lang": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Language code; defaults to the voice's language.",
          "title": "Lang"
        }
      },
      "title": "KokoroOptions",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "default": "Untitled",
          "title": "Title",
          "type": "string"
        }
      },
      "title": "Meta",
      "type": "object"
    },
    "Mount": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "container": {
          "title": "Container",
          "type": "string"
        },
        "mode": {
          "default": "ro",
          "enum": [
            "ro",
            "rw"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "host",
        "container"
      ],
      "title": "Mount",
      "type": "object"
    },
    "Overlay": {
      "additionalProperties": false,
      "description": "Text shown over the video. ``overlay: \"text\"`` is short for ``overlay: {text: \"text\"}``.",
      "properties": {
        "position": {
          "anyOf": [
            {
              "enum": [
                "top-left",
                "top",
                "top-right",
                "left",
                "center",
                "right",
                "bottom-left",
                "bottom",
                "bottom-right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where in the picture (default bottom-right).",
          "title": "Position"
        },
        "size": {
          "anyOf": [
            {
              "enum": [
                "small",
                "medium",
                "large"
              ],
              "type": "string"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text size: small, medium, large, or a factor of terminal.font_size (default medium).",
          "title": "Size"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text colour, #rrggbb (default #ffffff).",
          "title": "Color"
        },
        "background": {
          "anyOf": [
            {
              "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Box colour, #rrggbb or #rrggbbaa with alpha (default #000000b3).",
          "title": "Background"
        },
        "box": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Draw the rounded box; false shows outlined text only.",
          "title": "Box"
        },
        "bold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bold"
        },
        "duration_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hide after this long; by default it stays until the scene ends.",
          "title": "Duration Ms"
        },
        "keep": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stay past the scene's end until another overlay takes its position.",
          "title": "Keep"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "style": {
          "default": "default",
          "description": "Named style from overlay_styles (built in: default, chapter).",
          "title": "Style",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Overlay",
      "type": "object"
    },
    "OverlayStyle": {
      "additionalProperties": false,
      "description": "How an overlay looks and how long it stays. Unset keys come from its style.",
      "properties": {
        "position": {
          "anyOf": [
            {
              "enum": [
                "top-left",
                "top",
                "top-right",
                "left",
                "center",
                "right",
                "bottom-left",
                "bottom",
                "bottom-right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where in the picture (default bottom-right).",
          "title": "Position"
        },
        "size": {
          "anyOf": [
            {
              "enum": [
                "small",
                "medium",
                "large"
              ],
              "type": "string"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text size: small, medium, large, or a factor of terminal.font_size (default medium).",
          "title": "Size"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text colour, #rrggbb (default #ffffff).",
          "title": "Color"
        },
        "background": {
          "anyOf": [
            {
              "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Box colour, #rrggbb or #rrggbbaa with alpha (default #000000b3).",
          "title": "Background"
        },
        "box": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Draw the rounded box; false shows outlined text only.",
          "title": "Box"
        },
        "bold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bold"
        },
        "duration_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hide after this long; by default it stays until the scene ends.",
          "title": "Duration Ms"
        },
        "keep": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stay past the scene's end until another overlay takes its position.",
          "title": "Keep"
        }
      },
      "title": "OverlayStyle",
      "type": "object"
    },
    "PiperOptions": {
      "additionalProperties": false,
      "properties": {
        "length_scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Length Scale",
          "type": "number"
        },
        "sentence_silence": {
          "default": 0.2,
          "minimum": 0,
          "title": "Sentence Silence",
          "type": "number"
        }
      },
      "title": "PiperOptions",
      "type": "object"
    },
    "Requires": {
      "additionalProperties": false,
      "properties": {
        "tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "title": "Requires",
      "type": "object"
    },
    "Reveal": {
      "additionalProperties": false,
      "description": "Select a file or directory in the editor layout's explorer.",
      "properties": {
        "reveal": {
          "description": "Path relative to the workspace.",
          "minLength": 1,
          "title": "Reveal",
          "type": "string"
        }
      },
      "required": [
        "reveal"
      ],
      "title": "Reveal",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "description": "Type a command, press Enter, then pause for ``timing.run_hold_ms``.",
      "properties": {
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        }
      },
      "required": [
        "run"
      ],
      "title": "Run",
      "type": "object"
    },
    "Sandbox": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "default": "none",
          "enum": [
            "none",
            "allowlist",
            "full"
          ],
          "title": "Network",
          "type": "string"
        },
        "allow_hosts": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$",
            "type": "string"
          },
          "title": "Allow Hosts",
          "type": "array"
        },
        "env_passthrough": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "title": "Env Passthrough",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Env",
          "type": "object"
        },
        "extra_mounts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Mount"
          },
          "title": "Extra Mounts",
          "type": "array"
        },
        "ssh_agent": {
          "default": false,
          "title": "Ssh Agent",
          "type": "boolean"
        },
        "docker": {
          "default": false,
          "description": "Give the demo your Docker or Podman engine. This is full control of the host.",
          "title": "Docker",
          "type": "boolean"
        }
      },
      "title": "Sandbox",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "description": "One narrated (or silent) step of the video.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "narration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
