{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ditschi/narratty/main/schema/v1.json",
  "$defs": {
    "CtrlSequence": {
      "additionalProperties": false,
      "description": "Send a control chord such as ``C-c``.",
      "properties": {
        "ctrl_sequence": {
          "pattern": "^C-[A-Za-z@\\[\\]\\\\^_]$",
          "title": "Ctrl Sequence",
          "type": "string"
        }
      },
      "required": [
        "ctrl_sequence"
      ],
      "title": "CtrlSequence",
      "type": "object"
    },
    "EndCard": {
      "additionalProperties": false,
      "description": "The closing \"Created with narratty\" card with a link and QR code to the docs.",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show the card. Unset follows ~/.config/narratty/config.toml (on by default).",
          "title": "Enabled"
        },
        "duration_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "default": 4000,
          "description": "How long the card stays on screen.",
          "title": "Duration Ms"
        },
        "qr": {
          "default": true,
          "description": "Show a QR code of the docs link when the terminal is large enough.",
          "title": "Qr",
          "type": "boolean"
        }
      },
      "title": "EndCard",
      "type": "object"
    },
    "Enter": {
      "additionalProperties": false,
      "description": "Press Enter. Legacy form of ``key: Enter``, written as the bare string ``enter``.",
      "properties": {
        "enter": {
          "const": true,
          "default": true,
          "title": "Enter",
          "type": "boolean"
        }
      },
      "title": "Enter",
      "type": "object",
      "deprecated": true,
      "deprecationMessage": "Write `key: Enter` instead."
    },
    "Hold": {
      "additionalProperties": false,
      "description": "Pause. ``auto`` waits here until the narration has finished.\n\nOnly needed mid-scene: after the last action, a scene always waits for its narration.",
      "properties": {
        "hold": {
          "anyOf": [
            {
              "const": "auto",
              "type": "string"
            },
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "title": "Hold"
        }
      },
      "required": [
        "hold"
      ],
      "title": "Hold",
      "type": "object"
    },
    "Key": {
      "additionalProperties": false,
      "description": "Press a key, optionally repeated (``Down 3``). Names are case-insensitive.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "Key",
      "type": "object"
    },
    "KokoroOptions": {
      "additionalProperties": false,
      "properties": {
        "speed": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "number"
        },
        "lang": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Language code; defaults to the voice's language.",
          "title": "Lang"
        }
      },
      "title": "KokoroOptions",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "default": "Untitled",
          "title": "Title",
          "type": "string"
        }
      },
      "title": "Meta",
      "type": "object"
    },
    "Mount": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "container": {
          "title": "Container",
          "type": "string"
        },
        "mode": {
          "default": "ro",
          "enum": [
            "ro",
            "rw"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "host",
        "container"
      ],
      "title": "Mount",
      "type": "object"
    },
    "PiperOptions": {
      "additionalProperties": false,
      "properties": {
        "length_scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Length Scale",
          "type": "number"
        },
        "sentence_silence": {
          "default": 0.2,
          "minimum": 0,
          "title": "Sentence Silence",
          "type": "number"
        }
      },
      "title": "PiperOptions",
      "type": "object"
    },
    "Requires": {
      "additionalProperties": false,
      "properties": {
        "tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "title": "Requires",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "description": "Type a command, press Enter, then pause for ``timing.run_hold_ms``.",
      "properties": {
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        }
      },
      "required": [
        "run"
      ],
      "title": "Run",
      "type": "object"
    },
    "Sandbox": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "default": "none",
          "enum": [
            "none",
            "allowlist",
            "full"
          ],
          "title": "Network",
          "type": "string"
        },
        "allow_hosts": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$",
            "type": "string"
          },
          "title": "Allow Hosts",
          "type": "array"
        },
        "env_passthrough": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "title": "Env Passthrough",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Env",
          "type": "object"
        },
        "extra_mounts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Mount"
          },
          "title": "Extra Mounts",
          "type": "array"
        },
        "ssh_agent": {
          "default": false,
          "title": "Ssh Agent",
          "type": "boolean"
        }
      },
      "title": "Sandbox",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "description": "One narrated (or silent) step of the video.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "narration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration"
        },
        "actions": {
          "default": [],
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Run"
              },
              {
                "$ref": "#/$defs/TypeCommand"
              },
              {
                "$ref": "#/$defs/Enter"
              },
              {
                "$ref": "#/$defs/CtrlSequence"
              },
              {
                "$ref": "#/$defs/Hold"
              },
              {
                "$ref": "#/$defs/Wait"
              },
              {
                "$ref": "#/$defs/Key"
              },
              {
                "const": "enter",
                "description": "Press Enter. Legacy form of ``key: Enter``, written as the bare string ``enter``.",
                "deprecated": true,
                "deprecationMessage": "Write `key: Enter` instead."
              }
            ]
          },
          "title": "Actions",
          "type": "array"
        },
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "typing_speed_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typing Speed Ms"
        },
        "narration_start": {
          "default": "with_actions",
          "enum": [
            "with_actions",
            "after_actions"
          ],
          "title": "Narration Start",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Scene",
      "type": "object"
    },
    "Terminal": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "default": 1200,
          "minimum": 100,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 700,
          "minimum": 100,
          "title": "Height",
          "type": "integer"
        },
        "theme": {
          "default": "Dracula",
          "title": "Theme",
          "type": "string"
        },
        "font_size": {
          "default": 22,
          "minimum": 6,
          "title": "Font Size",
          "type": "integer"
        },
        "typing_speed_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "default": 40,
          "title": "Typing Speed Ms"
        },
        "shell": {
          "default": "bash",
          "enum": [
            "bash",
            "zsh",
            "fish",
            "sh"
          ],
          "title": "Shell",
          "type": "string"
        },
        "prompt": {
          "default": "$ ",
          "title": "Prompt",
          "type": "string"
        }
      },
      "title": "Terminal",
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "properties": {
        "narration_buffer_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "default": 500,
          "title": "Narration Buffer Ms"
        },
        "lead_in_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "default": 300,
          "title": "Lead In Ms"
        },
        "tail_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "default": 1000,
          "title": "Tail Ms"
        },
        "run_hold_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "default": 500,
          "description": "Pause after each `run` action.",
          "title": "Run Hold Ms"
        }
      },
      "title": "Timing",
      "type": "object"
    },
    "TtsConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "kokoro",
          "title": "Provider",
          "type": "string"
        },
        "voice": {
          "default": "af_heart",
          "description": "Voice id; defaults to af_heart for kokoro and en_US-lessac-medium for piper.",
          "title": "Voice",
          "type": "string"
        },
        "piper": {
          "$ref": "#/$defs/PiperOptions",
          "default": {
            "length_scale": 1.0,
            "sentence_silence": 0.2
          }
        },
        "kokoro": {
          "$ref": "#/$defs/KokoroOptions",
          "default": {
            "speed": 1.0,
            "lang": null
          }
        },
        "lexicon": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "default": {},
          "description": "How to say terms the narration spells literally, e.g. {'k8s': 'kubernetes'}. Overrides the built-in, user and project lexicons.",
          "propertyNames": {
            "minLength": 1
          },
          "title": "Lexicon",
          "type": "object"
        }
      },
      "title": "TtsConfig",
      "type": "object"
    },
    "TypeCommand": {
      "additionalProperties": false,
      "description": "Type text at the scene's typing speed without pressing Enter (use ``run`` for commands).",
      "properties": {
        "type_command": {
          "minLength": 1,
          "title": "Type Command",
          "type": "string"
        }
      },
      "required": [
        "type_command"
      ],
      "title": "TypeCommand",
      "type": "object"
    },
    "Wait": {
      "additionalProperties": false,
      "description": "Block until ``wait.screen`` matches the terminal content.\n\n``wait: \"pattern\"`` is short for ``wait: {screen: \"pattern\"}``.",
      "properties": {
        "wait": {
          "anyOf": [
            {
              "type": "string",
              "description": "Regular expression; short for {screen: ...}."
            },
            {
              "$ref": "#/$defs/WaitSpec"
            }
          ]
        }
      },
      "required": [
        "wait"
      ],
      "title": "Wait",
      "type": "object"
    },
    "WaitSpec": {
      "additionalProperties": false,
      "description": "Wait until the screen matches a regular expression.",
      "properties": {
        "screen": {
          "minLength": 1,
          "title": "Screen",
          "type": "string"
        },
        "timeout_ms": {
          "anyOf": [
            {
              "description": "Milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "e.g. 1.5s, 800ms, 2m",
              "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$",
              "type": "string"
            }
          ],
          "default": 15000,
          "title": "Timeout Ms"
        }
      },
      "required": [
        "screen"
      ],
      "title": "WaitSpec",
      "type": "object"
    },
    "Workspace": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "default": ".",
          "title": "Source",
          "type": "string"
        },
        "mode": {
          "default": "snapshot",
          "enum": [
            "snapshot",
            "rw",
            "ro"
          ],
          "title": "Mode",
          "type": "string"
        },
        "include_uncommitted": {
          "default": true,
          "title": "Include Uncommitted",
          "type": "boolean"
        },
        "caches": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Caches",
          "type": "object"
        },
        "artifacts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        }
      },
      "title": "Workspace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A complete ``.narratty.yaml`` document.",
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "meta": {
      "$ref": "#/$defs/Meta",
      "default": {
        "title": "Untitled"
      }
    },
    "tts": {
      "$ref": "#/$defs/TtsConfig",
      "default": {
        "provider": "kokoro",
        "voice": "af_heart",
        "piper": {
          "length_scale": 1.0,
          "sentence_silence": 0.2
        },
        "kokoro": {
          "lang": null,
          "speed": 1.0
        },
        "lexicon": {}
      }
    },
    "timing": {
      "$ref": "#/$defs/Timing",
      "default": {
        "narration_buffer_ms": 500,
        "lead_in_ms": 300,
        "tail_ms": 1000,
        "run_hold_ms": 500
      }
    },
    "terminal": {
      "$ref": "#/$defs/Terminal",
      "default": {
        "width": 1200,
        "height": 700,
        "theme": "Dracula",
        "font_size": 22,
        "typing_speed_ms": 40,
        "shell": "bash",
        "prompt": "$ "
      }
    },
    "requires": {
      "$ref": "#/$defs/Requires",
      "default": {
        "tools": []
      }
    },
    "workspace": {
      "$ref": "#/$defs/Workspace",
      "default": {
        "source": ".",
        "mode": "snapshot",
        "include_uncommitted": true,
        "caches": {},
        "artifacts": []
      }
    },
    "sandbox": {
      "$ref": "#/$defs/Sandbox",
      "default": {
        "network": "none",
        "allow_hosts": [],
        "env_passthrough": [],
        "env": {},
        "extra_mounts": [],
        "ssh_agent": false
      }
    },
    "end_card": {
      "anyOf": [
        {
          "type": "boolean",
          "description": "Short for {enabled: ...}."
        },
        {
          "$ref": "#/$defs/EndCard"
        }
      ],
      "default": {
        "enabled": null,
        "duration_ms": 4000,
        "qr": true
      }
    },
    "subtitles": {
      "default": "none",
      "description": "Subtitles from the narration: files (.srt/.vtt beside the output), track (soft track in the mp4) or burn (drawn into the video).",
      "enum": [
        "none",
        "files",
        "track",
        "burn"
      ],
      "title": "Subtitles",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    }
  },
  "required": [
    "scenes"
  ],
  "title": "narratty spec",
  "type": "object"
}
